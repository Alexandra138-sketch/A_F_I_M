# Copiar para .env e preencher. O .env NÃO vai para o repositório.
# Mínimo de 32 caracteres aleatórios, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=
# Validade do token, em segundos (900 por omissão)
JWT_VALIDADE=900

# --- Ensaios da API05 (desligados por omissão; deixar comentados no uso normal) ---
# 1: o servidor cria a sugestão, guarda a chave e fecha a ligação sem responder
#    (só na primeira vez que cada Idempotency-Key é processada com sucesso)
#SIMULAR_PERDA_RESPOSTA=1
# n: os próximos n pedidos POST /v2/sugestoes recebem 503 com Retry-After: 2
#SIMULAR_503=3
